# Скопируй в local.env и подставь свои значения.
# local.env в .gitignore — личные данные не попадут в репозиторий.

# Префикс bundle ID: приложение получит <префикс>.NoShortsThere
BUNDLE_ID_PREFIX=com.example

# ID команды разработчика (Xcode → Settings → Accounts → твоя команда).
# Оставь пустым для ad-hoc подписи — тогда в Safari придётся включать
# «Разрешить неподписанные расширения» после каждого перезапуска.
DEVELOPMENT_TEAM=
