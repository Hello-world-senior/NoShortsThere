# Скопируйте в local.env и укажите свои значения.
# local.env исключён из git — персональные данные не попадут в репозиторий.

# Префикс bundle ID: приложение получит <префикс>.NoShortsThere
BUNDLE_ID_PREFIX=com.example

# ID команды разработчика (Xcode → Settings → Accounts → нужная команда).
# Если оставить пустым, сборка будет подписана ad-hoc, и после каждого
# перезапуска Safari придётся заново разрешать неподписанные расширения.
DEVELOPMENT_TEAM=
